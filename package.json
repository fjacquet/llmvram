{
  "name": "llmvram",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "refresh:models": "tsx scripts/fetch-models.ts",
    "refresh:gpus": "tsx scripts/fetch-gpus.ts",
    "refresh:all": "npm run refresh:models && npm run refresh:gpus",
    "generate:icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "decimal.js": "^10.4.3",
    "html2canvas-pro": "^2.0.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "pptxgenjs-plus": "^4.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.7",
    "filelist": {
      "brace-expansion": "^2.1.2"
    },
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
